# ---------------------------------------------------------------------------
# CESIZen - Modèle de configuration d'environnement
#
# Copier en .env sur le serveur cible, puis : chmod 600 .env
# Ce fichier modèle est versionné ; le .env réel ne l'est JAMAIS (.gitignore).
# Les valeurs de production sont détenues dans les GitHub Secrets du dépôt et
# reportées sur le VPS lors de l'installation initiale.
# ---------------------------------------------------------------------------

# --- Domaine et certificats ------------------------------------------------
DOMAIN=api.cesizen.fr
ACME_EMAIL=admin@cesizen.fr

# --- Django ----------------------------------------------------------------
# Génération : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Clé de chiffrement applicatif des champs sensibles (commentaires du tracker).
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation annuelle, ou immédiate en cas de suspicion de compromission.
FIELD_ENCRYPTION_KEY=

# --- Base de données -------------------------------------------------------
POSTGRES_DB=cesizen
POSTGRES_USER=cesizen
# 32 caractères minimum, généré aléatoirement, jamais réutilisé entre environnements
POSTGRES_PASSWORD=

# --- Sauvegardes -----------------------------------------------------------
BACKUP_PASSPHRASE=
S3_BUCKET=cesizen-backups-gra

# --- Messagerie transactionnelle -------------------------------------------
EMAIL_HOST=smtp.example.fr
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Supervision -----------------------------------------------------------
# Sentry auto-hébergé ou instance UE : aucun transfert de données hors Union
SENTRY_DSN=

# --- Image déployée --------------------------------------------------------
# Renseigné automatiquement par le workflow de déploiement (.env.image)
IMAGE_TAG=latest
